@* Cross-file fixture: calls to injected services, the @inherits and
   @implements bases, and component tags resolve in other files, so Razor
   emits structured pending rows for them. The call to LocalHelper resolves
   in this file. *@

@page "/example"
@using OtherProject.Models
@inherits LayoutComponentBase
@implements IDisposable
@inject IItemService Items

<h3>Example Page</h3>
<p>@LocalHelper()</p>
<ItemCard Item="@current" />

@code {
    private ItemFromOther? current;

    private int LocalHelper() { return 42; }

    private async Task Entry() {
        current = await Items.LoadAsync(7);
        _ = LocalHelper();
    }

    public void Dispose() { }
}
